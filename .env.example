MEDFLOW_DB=data/medflow.sqlite
MEDFLOW_HOST=127.0.0.1
MEDFLOW_PORT=8000
# Local, single-user prototype. Do not expose it to a network without authentication.
# Optional: set on the server only. Never put API keys in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Use a Google AI Studio Free Tier project without billing to stay within free quotas.
# Only synthetic summary facts are eligible for Gemini; deterministic fallback is always available.
